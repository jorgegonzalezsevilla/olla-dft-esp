&CONTROL
  calculation      = 'scf'
  prefix           = 'Fe'
  outdir           = './out'
  pseudo_dir       = '/tmp/pseudo_metal'
  tprnfor          = .true.
  tstress          = .true.
/
&SYSTEM
  ibrav            = 0
  nat              = 1
  ntyp             = 1
  ecutwfc          = 60
  ecutrho          = 480
  nspin            = 2
  starting_magnetization(1) = 0.7
  occupations      = 'smearing'
  smearing         = 'cold'
  degauss          = 0.01
/
&ELECTRONS
  conv_thr         = 1e-08
  mixing_beta      = 0.4
  electron_maxstep = 200
/

ATOMIC_SPECIES
  Fe     55.8450  Fe.pz-nd-rrkjus.UPF

ATOMIC_POSITIONS crystal
  Fe    0.0000000000   0.0000000000   0.0000000000

CELL_PARAMETERS angstrom
    2.4854929089   0.0000000000   0.0000000000
   -0.8284976363   2.3433451873   0.0000000000
   -0.8284976363  -1.1716725936   2.0293964620

K_POINTS automatic
  16 16 16 0 0 0
