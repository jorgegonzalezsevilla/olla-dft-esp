&CONTROL
  calculation      = 'scf'
  prefix           = 'Si'
  outdir           = './out'
  pseudo_dir       = '/tmp/pseudo_si'
  tprnfor          = .true.
  tstress          = .true.
/
&SYSTEM
  ibrav            = 0
  nat              = 2
  ntyp             = 1
  ecutwfc          = 60
  ecutrho          = 480
  occupations      = 'fixed'
/
&ELECTRONS
  conv_thr         = 1e-08
  mixing_beta      = 0.4
  electron_maxstep = 200
/

ATOMIC_SPECIES
  Si     28.0850  Si.pz-vbc.UPF

ATOMIC_POSITIONS crystal
  Si    0.5000000000   0.5000000000   0.5000000000
  Si    0.7500000000   0.7500000000   0.7500000000

CELL_PARAMETERS angstrom
    0.0000000000   2.7155000000   2.7155000000
    2.7155000000   0.0000000000   2.7155000000
    2.7155000000   2.7155000000   0.0000000000

K_POINTS automatic
  11 11 11 0 0 0
